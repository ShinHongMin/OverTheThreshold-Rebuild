  eventTitle: "\uACFC\uAC70\uC758 \uAE30\uC5B5 \uD30C\uD3B8 "
  eventImage: {fileID: -5754234965159179902, guid: 0a39826d9c806fc44a1205337cb9d13e, type: 3}
  description: "\"\uC624\uC5FC\uB41C \uC6B0\uC8FC \uACF5\uAC04\uC744 \uC9C0\uB098\uB358
    \uC911, \uC624\uB798\uB41C \uC804\uD22C\uC758 \uC794\uD574 \uC18D\uC5D0\uC11C
    \uC778\uB958\uC758 \uACFC\uAC70 \uAE30\uB85D\uBB3C \uD30C\uD3B8\uC744 \uBC1C\uACAC\uD569\uB2C8\uB2E4.
    \uC9C0\uD718\uAD00\uC758 \uC815\uC2E0\uC5D0 \uC9C1\uC811 \uC5F0\uACB0\uB418\uC5B4
    \uC544\uD508 \uAE30\uC5B5\uC744 \uB5A0\uC62C\uB9AC\uAC8C \uD569\uB2C8\uB2E4.\""
  choices:
  - choiceText: "\uAE30\uB85D\uBB3C\uC744 \uC77D\uACE0 \uAE30\uC5B5\uC744 \uB418\uC0B4\uB9B0\uB2E4."
    resultText: "\uACFC\uAC70\uC758 \uC544\uD514\uC5D0 \uC7A0\uC2DD\uB429\uB2C8\uB2E4.(\uC601\uAD6C\uC801\uC73C\uB85C
      \uBAA8\uB4E0 \uC544\uAD70\uC758 ER \uC218\uCE58 \uD68D\uB4DD\uB7C9 +10% \uC99D\uAC00),
      \uD558\uC9C0\uB9CC \uC78A\uD78C \uC804\uC220\uC744 \uB418\uCC3E\uC2B5\uB2C8\uB2E4.(\uC601\uAD6C\uC801\uC73C\uB85C
      \uBAA8\uB4E0 \uC544\uAD70\uC758 \uACF5\uACA9\uB825 +5% \uC99D\uAC00)"
    successRate: 100
    effects:
    - effectType: 10
      effectValue: -10
      targetStat: 4
      targetPassives: []
      enemyEncounter: {fileID: 0}
    - effectType: 10
      effectValue: 5
      targetStat: 2
      targetPassives: []
      enemyEncounter: {fileID: 0}
