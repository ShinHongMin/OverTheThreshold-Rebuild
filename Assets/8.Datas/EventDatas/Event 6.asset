    failureEffects: []
  - choiceText: "\uAE30\uB85D\uBB3C\uC744 \uD30C\uAD34\uD558\uACE0 \uAE30\uC5B5\uC744
      \uC9C0\uC6B4\uB2E4."
    resultText: "\uBBF8\uB798\uB97C \uC704\uD574 \uACFC\uAC70\uB97C \uB193\uC544\uC90D\uB2C8\uB2E4.(\uC601\uAD6C\uC801\uC73C\uB85C
